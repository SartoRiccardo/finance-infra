# read automatically by `docker compose` for variable substitution in compose.yaml
# (unlike secrets/.env.api, which is only injected into the backend container).
# not a secret - pin a specific backend image tag for reproducible deploys, or leave as latest.
BACKEND_IMAGE_TAG=latest

# path to the central vps-caddy dir on this VPS (see update-frontend.sh) - leave
# unset to just build frontend-dist/ locally without copying it anywhere
CADDY_DIR=/home/youruser/services/vps-caddy
