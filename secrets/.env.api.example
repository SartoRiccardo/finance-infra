# Full env contract for the finance backend (injected into the container via
# compose's env_file). Copy to secrets/.env.api and fill in; never commit it.

# host is the compose service name of the db container (see compose.yaml), not localhost
DATABASE_URL=postgresql+asyncpg://pf:pf@db:5432/pf
SESSION_SECRET=change-me-to-a-long-random-string
# the one admin account; also the OAuth gate (only this email may log in)
MASTER_ADMIN_EMAIL=rikki.sarto@gmail.com
# redirect URI to register on the Google OAuth client:
#   https://finance.sarto.dev/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FRONTEND_URL=https://finance.sarto.dev
# must be exactly "production" - that's the string config.py's is_prod/dev_auth_enabled check
ENV=production
# NEVER true in prod - it registers an unauthenticated dev-login route
DEV_AUTH_BYPASS=false

# V5 photo drafts - empty keys boot fine; a missing key only fails at real extraction.
LLM_PROVIDER=google
LLM_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
# lives on the backend_data volume (mounted at /app/data)
UPLOAD_DIR=/app/data/uploads

# V6 email ingestion
INGEST_IMAP_HOST=imap.gmail.com
INGEST_IMAP_PORT=993
INGEST_IMAP_USER=rikki.sarto@gmail.com
# Gmail app password
INGEST_IMAP_PASSWORD=
INGEST_MAIL_ALIAS=rikki.sarto+finance@gmail.com
INGEST_POLL_SECONDS=60
